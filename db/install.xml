<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/ruleofthree/db" VERSION="20260912" COMMENT="XMLDB file for mod_ruleofthree"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="ruleofthree" COMMENT="Rule of three activity instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="simple" SEQUENCE="false"/>
        <FIELD NAME="simplerelation" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="direct" SEQUENCE="false"/>
        <FIELD NAME="simplea" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="2" SEQUENCE="false"/>
        <FIELD NAME="simpleb" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="4" SEQUENCE="false"/>
        <FIELD NAME="simplec" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="3" SEQUENCE="false"/>
        <FIELD NAME="simpled" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="6" SEQUENCE="false"/>
        <FIELD NAME="compounda1" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="2" SEQUENCE="false"/>
        <FIELD NAME="compounda2" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="4" SEQUENCE="false"/>
        <FIELD NAME="compoundb1" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="3" SEQUENCE="false"/>
        <FIELD NAME="compoundb2" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="6" SEQUENCE="false"/>
        <FIELD NAME="compoundr1" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="10" SEQUENCE="false"/>
        <FIELD NAME="compoundr2" TYPE="number" LENGTH="20" DECIMALS="6" NOTNULL="true" DEFAULT="40" SEQUENCE="false"/>
        <FIELD NAME="compoundarelation" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="direct" SEQUENCE="false"/>
        <FIELD NAME="compoundbrelation" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="direct" SEQUENCE="false"/>
        <FIELD NAME="precision" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="2" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
