{{!
    @template mod_ruleofthree/calculator

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="mod-ruleofthree" data-region="ruleofthree">
    {{#intro}}
        <div class="mod-ruleofthree__intro">{{{intro}}}</div>
    {{/intro}}

    {{#simple}}
        <div class="mod-ruleofthree__tip">{{#str}}changetip, mod_ruleofthree{{/str}}</div>
        <div class="mod-ruleofthree__simple-grid" data-region="simple-grid">
            {{#simplevalues}}
                <label class="mod-ruleofthree__field">
                    <span class="mod-ruleofthree__label">{{label}}</span>
                    <input class="form-control mod-ruleofthree__input"
                           type="text"
                           inputmode="decimal"
                           autocomplete="off"
                           data-value="{{key}}"
                           value="{{value}}">
                </label>
            {{/simplevalues}}
        </div>
    {{/simple}}

    {{#compound}}
        <div class="mod-ruleofthree__tip">{{#str}}compoundtip, mod_ruleofthree{{/str}}</div>
        <div class="mod-ruleofthree__table-wrap">
            <table class="table mod-ruleofthree__table">
                <thead>
                    <tr>
                        <th></th>
                        <th>{{#str}}situation1, mod_ruleofthree{{/str}}</th>
                        <th>{{#str}}situation2, mod_ruleofthree{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#compoundrows}}
                        <tr>
                            <th scope="row">{{label}}</th>
                            <td>
                                <input class="form-control mod-ruleofthree__input"
                                       type="text"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       data-value="{{key1}}"
                                       value="{{value1}}">
                            </td>
                            <td>
                                <input class="form-control mod-ruleofthree__input"
                                       type="text"
                                       inputmode="decimal"
                                       autocomplete="off"
                                       data-value="{{key2}}"
                                       value="{{value2}}">
                            </td>
                        </tr>
                    {{/compoundrows}}
                </tbody>
            </table>
        </div>
    {{/compound}}

    <div class="mod-ruleofthree__error alert alert-danger d-none" data-region="error" role="alert"></div>

    <section class="mod-ruleofthree__calculation" aria-live="polite">
        <h3>{{#str}}calculation, mod_ruleofthree{{/str}}</h3>
        <div data-region="calculation"></div>
    </section>
</div>
